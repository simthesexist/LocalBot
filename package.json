{
  "name": "localbot",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop AI agent app (Electron + React 19 + TypeScript)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/main/daemon',{recursive:true});fs.cpSync('daemon','dist/main/daemon',{recursive:true,filter:(s)=>!s.endsWith('.map')})\"",
    "start": "electron dist/main/index.js",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:all": "npm test && npm run test:smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  }
}
